(defcfg
  process-unmapped-keys yes
  tap-hold-require-prior-idle 200
)

(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m , . /
  caps
  lmet rmet
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defvar
  tap-time 200
  hold-time 200
)


(defalias
  ;; Home row mods
  a-mod (tap-hold $tap-time $hold-time a lmet)
  s-mod (tap-hold $tap-time $hold-time s lalt)
  d-mod (tap-hold $tap-time $hold-time d lsft)
  f-mod (tap-hold $tap-time $hold-time f lctl)

  j-mod (tap-hold $tap-time $hold-time j rctl)
  k-mod (tap-hold $tap-time $hold-time k rsft)
  l-mod (tap-hold $tap-time $hold-time l ralt)

  ;; Layer modifiers
  num (tap-hold $tap-time $hold-time lmet (layer-while-held numbers))
  sym (tap-hold $tap-time $hold-time rmet (layer-while-held symbols))

  bang S-1
  question S-/
  lbrace S-[
  rbrace S-]
  plus S-=
  dollar S-4
  pipe S-\
  tilde S-grv
  less S-,
  greater S-.
  lparen S-9
  rparen S-0
  dquote S-'
  hash S-3
  star S-8
)

(deflayer base
  q w e r t y u i o p
  @a-mod @s-mod @d-mod @f-mod g h @j-mod @k-mod @l-mod ;
  z x c v b n m , . /
  esc
  @num @sym
  🔅 🔆 nop0 nop1 nop2 nop3 ◀◀ ▶⏸ ▶▶ 🔇 🔉 🔊
)

(deflayer numbers
  _ _ _ _ _ _ _ _ _ _
  1 2 3 4 5 6 7 8 9 0
  _ _ _ _ _ _ _ _ _ _
  _
  _ _
  _ _ _ _ _ _ _ _ _ _ _ _
)

(deflayer symbols
  @S-1 ? { } + $ grv | _ ~
  < > ( ) - = ' , ; .
  _ \ [ ] / _ " # _ *
  _
  _ _
  _ _ _ _ _ _ _ _ _ _ _ _
)
