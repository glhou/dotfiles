(defcfg
  process-unmapped-keys yes
  tap-hold-require-prior-idle 170
)

(defsrc
  esc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m
  spc
  caps
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defvar
  tap-time 170
  hold-time 170
)

(defalias
  ;; Home row mods
  a-mod (tap-hold $tap-time $hold-time a lmet)
  s-mod (tap-hold $tap-time $hold-time s lalt)
  d-mod (tap-hold $tap-time $hold-time d lsft)
  f-mod (tap-hold $tap-time $hold-time f lctl)

  j-mod (tap-hold $tap-time $hold-time j rctl)
  k-mod (tap-hold $tap-time $hold-time k rsft)
  l-mod (tap-hold $tap-time $hold-time l ralt)
  ;-mod (tap-hold $tap-time $hold-time ; rmet)

  ;; Layers
  num (tap-hold $tap-time $hold-time esc (layer-while-held numbers))
  sym (tap-hold $tap-time $hold-time spc (layer-while-held symbols))
)

(deflayer base
  esc
  q w e r t y u i o p
  @a-mod @s-mod @d-mod @f-mod g h @j-mod @k-mod @l-mod @;-mod
  z x c v b n m
  @sym
  @num
  🔅 🔆 nop0 nop1 nop2 nop3 ◀◀ ▶⏸ ▶▶ 🔇 🔉 🔊
)

(deflayer numbers
  _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ 7 8 9 _
  _ _ _ _ _ _ 4 5 6 _
  _ _ _ _ _ 1 2 3
  _
  _
  _ _ _ _ _ _ _ _ _ _ _ _
)

(deflayer symbols
  _
  grv til ! @ # $ % ^ & * 
  _ _ _ _ _ _ lbrc rbrc paren-l paren-r
  _ _ _ _ _ _ - _ = +
  _ _ _ _ _ _ _ 
  _
  _
  _ _ _ _ _ _ _ _ _ _ _ _
)
